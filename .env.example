# Calendly link used by /book
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/sociallyelisa-info

# Contact form (/api/contact). RESEND_API_KEY is REQUIRED — without it the form
# returns 500 to every visitor and leads are only recoverable from the logs.
# RESEND_API_KEY=
# Sender address. Must sit on a domain verified in the Resend account, or Resend
# rejects the send. Defaults to "Socially Elisa <info@sociallyelisa.com>".
# CONTACT_FROM_EMAIL=
# Optional. Copied on every lead so a broken inbox rule is caught early. Unset
# means nobody is copied — there is no fallback address on purpose.
# OPERATOR_EMAIL=

# Stripe (only needed when replacing the mock /checkout)
# STRIPE_SECRET_KEY=
# STRIPE_PRICE_BLOOM=
# STRIPE_PRICE_BLOSSOM=
# STRIPE_PRICE_FULL_BLOOM=
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
